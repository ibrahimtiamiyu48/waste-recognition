<mxfile host="app.diagrams.net"><diagram id="lab05" name="Input validation path"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0" /><mxCell id="t0" value="&lt;b&gt;Waste Recognition — Lab 05 input assurance&lt;/b&gt; (src/input_validation.py → src/inference_demo.py)" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="8" width="1300" height="26" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Rule:&lt;/b&gt; validation runs before prediction; only a &lt;b&gt;pass&lt;/b&gt; reaches the model. Checks are request-level (the photo is not opened)." style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="43" width="1300" height="26" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Runtime identity:&lt;/b&gt; PREPROCESSING_ID = features-v1 is defined in inference_demo.py, never taken from the request." style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="67" width="1300" height="26" as="geometry"/></mxCell><mxCell id="f0" value="Runs on: collection-point laptop (shared computer)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="900" height="630" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;VALIDATOR&lt;/b&gt; — validate_request(), rules from input_contract.json" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="225" y="165" width="345" height="375" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Staff at the tray screen&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="270" height="460" as="geometry"/></mxCell><mxCell id="req" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;input_ref · format ·&lt;br&gt;width · height · source&lt;br&gt;&lt;i&gt;from tray camera or phone&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="300" width="165" height="110" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;input_reference_present&lt;/b&gt;&lt;br&gt;non-empty → else &lt;b&gt;error&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="205" width="300" height="50" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;format_supported&lt;/b&gt;&lt;br&gt;jpg / jpeg → else &lt;b&gt;error&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="267" width="300" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;dimensions_match_tray_camera&lt;/b&gt;&lt;br&gt;512×384 → else &lt;b&gt;error&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="329" width="300" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;source_is_tray_camera&lt;/b&gt;&lt;br&gt;tray-camera · trashnet-test → else &lt;b&gt;warning&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="391" width="300" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;preprocessing_identity_match&lt;/b&gt;&lt;br&gt;runtime features-v1 = contract → else &lt;b&gt;error&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="453" width="300" height="50" as="geometry"/></mxCell><mxCell id="comb" value="&lt;b&gt;Combine&lt;/b&gt;&lt;br&gt;most severe wins&lt;br&gt;error &amp;gt; warning &amp;gt; pass" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="180" height="130" as="geometry"/></mxCell><mxCell id="pass" value="&lt;b&gt;pass → call_prediction&lt;/b&gt;&lt;br&gt;project_predict()&lt;br&gt;baseline-v1 + decision-v1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="200" height="80" as="geometry"/></mxCell><mxCell id="warn" value="&lt;b&gt;warning → route_for_review&lt;/b&gt;&lt;br&gt;prediction NOT called" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="830" y="315" width="200" height="80" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;error → reject_input&lt;/b&gt;&lt;br&gt;prediction NOT called" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="830" y="480" width="200" height="80" as="geometry"/></mxCell><mxCell id="s_ok" value="&lt;b&gt;ok / review (Lab 04 rule)&lt;/b&gt;&lt;br&gt;show material, or &#x27;Check by hand&#x27;&lt;br&gt;with top two materials" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1135" y="150" width="240" height="80" as="geometry"/></mxCell><mxCell id="s_warn" value="&lt;b&gt;Check by hand&lt;/b&gt;&lt;br&gt;photo not from the tray camera;&lt;br&gt;staff decide the container" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1135" y="315" width="240" height="80" as="geometry"/></mxCell><mxCell id="s_err" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;show the failed rule;&lt;br&gt;staff retake with the tray camera" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1135" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Evidence: reports/validation_demo.jsonl&lt;/b&gt;&lt;br&gt;one combined record per request, linked by &lt;b&gt;request_id&lt;/b&gt;&lt;br&gt;checks [rule · observed · status · action] · validation_status · action · prediction_called · prediction_status · result" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="240" y="635" width="790" height="100" as="geometry"/></mxCell><mxCell id="e1" value="request" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="355.0" as="sourcePoint"/><mxPoint x="225" y="355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="5 check&lt;br&gt;results" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="355" as="sourcePoint"/><mxPoint x="590" y="355.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="pass" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="290" as="sourcePoint"/><mxPoint x="830" y="190.0" as="targetPoint"/><Array as="points"><mxPoint x="680.0" y="190"/></Array></mxGeometry></mxCell><mxCell id="e4" value="warning" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="355.0" as="sourcePoint"/><mxPoint x="830" y="355.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="error" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="420" as="sourcePoint"/><mxPoint x="830" y="520.0" as="targetPoint"/><Array as="points"><mxPoint x="680.0" y="520"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="190.0" as="sourcePoint"/><mxPoint x="1135" y="190.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="355.0" as="sourcePoint"/><mxPoint x="1135" y="355.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="520.0" as="sourcePoint"/><mxPoint x="1135" y="520.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" value="checks[]" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="540" as="sourcePoint"/><mxPoint x="390" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="status · action ·&lt;br&gt;prediction_called · result" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><