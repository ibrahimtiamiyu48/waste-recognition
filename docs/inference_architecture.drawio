<mxfile host="app.diagrams.net"><diagram id="lab04" name="Inference path"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Waste Recognition — Lab 04 inference path&lt;/b&gt; (src/inference_demo.py)" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="trigger" value="&lt;b&gt;Trigger:&lt;/b&gt; user request — staff place one item on the tray and take a photo" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="45" width="700" height="26" as="geometry"/></mxCell><mxCell id="placement" value="&lt;b&gt;Intended placement:&lt;/b&gt; shared computer — a laptop at the collection point; the camera only captures the photo" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="72" width="900" height="26" as="geometry"/></mxCell><mxCell id="laptop" value="Runs on: collection-point laptop (shared computer)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="205" y="115" width="895" height="600" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;INFERENCE BOUNDARY&lt;/b&gt; — run_attempt(): accepted photo in, structured response out" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="245" width="650" height="290" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Staff at the tray screen&lt;/b&gt; — receive the response and act" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="115" width="260" height="430" as="geometry"/></mxCell><mxCell id="camera" value="&lt;b&gt;Tray camera&lt;/b&gt;&lt;br&gt;photo of one item&lt;br&gt;(TrashNet test photo in the demo)&lt;br&gt;&lt;i&gt;runs on: input device&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="280" width="150" height="90" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;Input check&lt;/b&gt;&lt;br&gt;readable image,&lt;br&gt;512×384&lt;br&gt;(same as Lab 02)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="270" width="160" height="110" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;Input rejected&lt;/b&gt;&lt;br&gt;message with reason → staff retake the photo&lt;br&gt;&lt;i&gt;(no record; never reaches the model)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="215" y="450" width="190" height="90" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;features(): 32×24 RGB pixels + HSV histogram" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="150" height="80" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Model baseline-v1&lt;/b&gt;&lt;br&gt;logistic regression&lt;br&gt;models/baseline-v1.joblib" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="150" height="80" as="geometry"/></mxCell><mxCell id="decision" value="&lt;b&gt;Decision decision-v1&lt;/b&gt;&lt;br&gt;review if confidence &amp;lt; 0.60&lt;br&gt;or glass runner-up ≥ 0.25" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="890" y="265" width="170" height="120" as="geometry"/></mxCell><mxCell id="unavail" value="&lt;b&gt;Inference unavailable&lt;/b&gt;&lt;br&gt;prediction cannot run&lt;br&gt;(forced in demo: simulated=true)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="425" width="150" height="80" as="geometry"/></mxCell><mxCell id="act_rev" value="&lt;b&gt;status = review&lt;/b&gt;&lt;br&gt;show &#x27;Check by hand&#x27; + top two materials; staff decide" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1135" y="155" width="230" height="75" as="geometry"/></mxCell><mxCell id="act_ok" value="&lt;b&gt;status = ok&lt;/b&gt;&lt;br&gt;show material; staff put the item in that container" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1135" y="290" width="230" height="70" as="geometry"/></mxCell><mxCell id="act_un" value="&lt;b&gt;status = unavailable&lt;/b&gt;&lt;br&gt;show &#x27;Sorting assistant offline&#x27;; staff sort by hand" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1135" y="425" width="230" height="80" as="geometry"/></mxCell><mxCell id="evidence" value="&lt;b&gt;Evidence: reports/inference_demo.jsonl&lt;/b&gt;&lt;br&gt;one line per attempt, linked by &lt;b&gt;request_id&lt;/b&gt;&lt;br&gt;input_ref · status · result · model_version · rule_version · latency_ms · action · simulated" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="600" width="610" height="95" as="geometry"/></mxCell><mxCell id="e1" value="photo&lt;br&gt;(input_ref)" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="camera" target="check"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="accepted&lt;br&gt;photo" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="prep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="rejected: unreadable&lt;br&gt;/ wrong size" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2,352&lt;br&gt;features" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="prep" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="probabilities&lt;br&gt;(4 materials)" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="response:&lt;br&gt;status=ok, result" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision" target="act_ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="response: status=review,&lt;br&gt;result + runner-up" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision" target="act_rev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="model cannot run" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="prep" target="unavail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="response: status=unavailable, result=null" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#b85450;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="unavail" target="act_un"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="record&lt;br&gt;(request_id)" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.86;entryY=0;strokeColor=#9673a6;" edge="1" parent="1" source="decision" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="record (request_id,&lt;br&gt;simulated=true)" style="endArrow=block;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.123;entryY=0;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="unavail" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
